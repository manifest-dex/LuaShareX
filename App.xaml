<Application x:Class="LuaShareX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:LuaShareX">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:NullToVisibilityConverter x:Key="NullToVis" />
            <local:BoolToAppearanceConverter x:Key="BoolToAppearance" />
            <local:InverseBoolToAppearanceConverter x:Key="InverseBoolToAppearance" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
