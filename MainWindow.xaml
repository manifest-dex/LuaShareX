<ui:FluentWindow x:Class="LuaShareX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LuaShareX.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="LuaShareX" Width="800" Height="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="LuaShareX" ShowMaximize="False" />

        <!-- Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="16,8">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel MaxWidth="400" Margin="32">
                            <TextBlock Text="LuaShareX" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="Export Steam games as Lua files" FontSize="13" Foreground="#6b7280" HorizontalAlignment="Center" Margin="0,0,0,24" />

                            <TextBlock Text="Username" FontSize="13" FontWeight="Medium" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Username, Mode=TwoWay}" PlaceholderText="Steam username" Margin="0,0,0,12" />

                            <TextBlock Text="Password" FontSize="13" FontWeight="Medium" Margin="0,0,0,4" />
                            <ui:PasswordBox Password="{Binding Password, Mode=TwoWay}" PlaceholderText="Steam password" Margin="0,0,0,12" />

                            <TextBlock Text="Auth Code" FontSize="13" FontWeight="Medium" Margin="0,0,0,4"
                                       Visibility="{Binding NeedsAuthCode, Converter={StaticResource BoolToVis}}" />
                            <ui:TextBox Text="{Binding AuthCode, Mode=TwoWay}" PlaceholderText="Steam Guard code"
                                       Visibility="{Binding NeedsAuthCode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12" />

                            <ui:Button Content="Login" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                      Command="{Binding LoginCommand}" IsEnabled="{Binding IsLogging, Converter={StaticResource InverseBool}}" />

                            <ui:Button Content="Anonymous" HorizontalAlignment="Stretch" Margin="0,0,0,16"
                                      Command="{Binding LoginAnonymousCommand}" IsEnabled="{Binding IsLogging, Converter={StaticResource InverseBool}}" />

                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#6b7280" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Viewbox>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:GamesViewModel}">
                    <Grid Margin="16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Your Games" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search games..." Margin="0,0,8,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="Select All" Command="{Binding ToggleSelectAllCommand}" Margin="0,0,4,0" Padding="12,6" />
                                <ui:Button Content="Fetch Details" Command="{Binding FetchDetailsCommand}" Margin="0,0,4,0" Padding="12,6" Appearance="Primary" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6b7280">
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                                <Run Text=" selected" />
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="Export .lua" Command="{Binding ExportSelectedCommand}" Margin="0,0,4,0" Padding="12,6" Appearance="Primary" />
                                <ui:Button Content="Copy" Command="{Binding CopyToClipboardCommand}" Padding="12,6" />
                            </StackPanel>
                        </Grid>

                        <!-- Loading -->
                        <StackPanel Grid.Row="3" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#6b7280" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Games List -->
                        <ListView Grid.Row="3" ItemsSource="{Binding Games}" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  BorderThickness="0" Background="Transparent"
                                  SelectionChanged="GamesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AppId}" Foreground="#6b7280" FontSize="12" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" FontSize="13" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#08ffffff" BorderBrush="#12ffffff" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#6b7280" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                    <ui:Button Content="Games" Command="{Binding NavigateToGamesCommand}" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                    <ui:Button Content="Logout" Command="{Binding LogoutCommand}" Padding="8,4" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
